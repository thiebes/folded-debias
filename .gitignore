# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Outputs
output/
*.png
*.svg
!docs/**/*.png
!docs/**/*.svg
# Each experiment set keeps its committed figure(s) in its own folder. Track
# those, but not regenerated run outputs.
!experiments/**/*.png
!experiments/**/*.svg
!illustrations/**/*.png
!illustrations/**/*.svg

# LaTeX build artifacts (write-ups are compiled inside their set folder)
experiments/**/*.aux
experiments/**/*.log
experiments/**/*.out
experiments/**/*.fls
experiments/**/*.fdb_latexmk
experiments/**/*.synctex.gz

# Source PDFs / extracted text (local reference only)
sources/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Collaborator data (Marc's pshare datasets) -- never committed; read locally
# or from the P: pshare. Each experiment
# set keeps its large/collaborator data in a local data/ dir, never committed;
# see the set's DATASETS.md for the pshare source.
mc_experiments/**/data/
experiments/**/data/

# Origin project binaries (raw published-figure data; extracted CSVs are committed)
*.opju
